rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Zero-trust default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Legacy Storage path is unused by the current backend/Firestore proof flow.
    // Deny all direct client reads and writes, including signed-in staff.
    match /payment_proofs/{bookingId}/{fileName} {
      allow read, write: if false;
    }

    // Therapist and staff profile avatars
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
